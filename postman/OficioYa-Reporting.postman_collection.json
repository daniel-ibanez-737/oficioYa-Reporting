                "value": "Bearer {{token_admin}}"
              }
            ],
            "url": {
              "raw": "{{reportingUrl}}/api/v1/reporting/reportes",
              "host": [
                "{{reportingUrl}}"
              ],
              "path": [
                "api",
                "v1",
                "reporting",
                "reportes"
              ]
            },
            "description": ""
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Responde 200', () => pm.response.to.have.status(200));",
